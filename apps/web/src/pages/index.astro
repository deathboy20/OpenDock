---
import AppsPanel from "../components/demo/AppsPanel.astro";
import DeskPanel from "../components/demo/DeskPanel.astro";
import Studio from "../components/demo/Studio.astro";
import LauncherPanel from "../components/demo/LauncherPanel.astro";
import LedgerPanel from "../components/demo/LedgerPanel.astro";
import ProjectsPanel from "../components/demo/ProjectsPanel.astro";
import RuleCard from "../components/demo/RuleCard.astro";
import Icon from "../components/Icon.astro";
import PlatformDownload from "../components/PlatformDownload.astro";
import StatusBadge from "../components/StatusBadge.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { currentRelease, downloadUrl, formatReleaseDate, platforms, primaryFile, releasePageUrl } from "../data/releases";
import { repoLinks, site } from "../data/site";
import { onlineWidgets, widgetCategories, widgets, widgetsIn } from "../data/widgets";

const setup = primaryFile(currentRelease, "windows");
const statusWord = { supported: "Supported", experimental: "Experimental" } as const;

const whatsNew = [
  { title: "Skins that change the shape", text: "Ten built-in skins, and layouts that split the dock into islands or chips. Import and share skins as JSON." },
  { title: "Widget looks", text: "Pick how each widget draws: a digital, stacked or analog clock, battery as a ring or dots, and more." },
  { title: "Desktop widgets", text: "Place widgets on the desktop itself, behind your windows. They snap to a grid and remember each monitor." },
  { title: "Scenes", text: "Save the dock, its look and its automations as a scene, then switch from the dock menu." },
  { title: "Developer widgets", text: "Projects, Vault capture, Local AI and CI status, for the folders and repositories you choose." },
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "OpenDock",
  description: site.description,
  url: site.url,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Windows 10, Windows 11, macOS, Linux",
  softwareVersion: currentRelease.version,
  downloadUrl: downloadUrl(currentRelease, setup.name),
  license: repoLinks.license,
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};

const restore = [
  { when: "You quit OpenDock", then: "Restored immediately." },
  { when: "OpenDock crashes or is force-closed", then: "A small guard process notices and restores it within seconds." },
  {
    when: "You sign out, restart or shut down from the launcher",
    then: "Restored before Windows starts closing apps.",
  },
  {
    when: "Windows ends the session and kills OpenDock and its guard together",
    then: "Auto-hide can stay on until the next time OpenDock starts. The taskbar is still reachable at the screen edge. OpenDock repairs it on that next start.",
  },
  { when: "You uninstall OpenDock", then: "The uninstaller restores the taskbar and removes OpenDock from startup." },
];

function networkNote(network: string[]): string {
  if (network.length === 0) return "Stays on this device";
  return `Contacts ${network[0]}`;
}
---

<BaseLayout description={site.description} structuredData={structuredData}>
  <section class="hero">
    <div class="container">
      <div class="hero-copy">
        <div class="stack">
          <a class="eyebrow-link" href="#whats-new">
            <strong>Version {currentRelease.version}</strong>
            <span class="eyebrow-detail">Skins, desktop widgets, scenes and developer widgets</span>
            <span class="eyebrow-short">What's new</span>
            <Icon name="arrow" size={14} />
          </a>
          <h1 class="display">The Windows taskbar, rebuilt in the open.</h1>
        </div>
        <div class="hero-side">
          <p class="lead">
            OpenDock replaces the taskbar with a dock of your apps, live window previews and widgets that can act for
            you. It runs entirely on your PC: no account, no telemetry.
          </p>
          <div class="hero-actions">
            <PlatformDownload />
            <a class="btn btn-secondary" href={site.repo}>
              <Icon name="github" size={18} />
              View source
            </a>
          </div>
          <ul class="hero-facts">
            <li><Icon name="check" size={16} />MIT licensed</li>
            <li><Icon name="check" size={16} />Works offline</li>
            <li><Icon name="check" size={16} />Taskbar restored on uninstall</li>
            <li><Icon name="check" size={16} />Experimental macOS and Linux builds</li>
          </ul>
        </div>
      </div>
      <Studio />
    </div>
  </section>

  <section class="section section--tight" id="whats-new" aria-labelledby="new-title">
    <div class="container release-strip">
      <header class="release-strip-head">
        <div>
          <h2 id="new-title">New in {currentRelease.version}</h2>
          <p class="muted">Released {formatReleaseDate(currentRelease.date)}</p>
        </div>
        <a class="link-arrow" href="/changelog/">
          Full changelog
          <Icon name="arrow" size={16} />
        </a>
      </header>
      <ul class="release-list">
        {
          whatsNew.map((item) => (
            <li>
              <strong>{item.title}</strong>
              <span>{item.text}</span>
            </li>
          ))
        }
      </ul>
      <figure class="real-shot">
        <img
          src="/screenshots/dock-windows.png"
          width="1280"
          height="280"
          loading="lazy"
          alt="OpenDock running on Windows, with pinned apps, open windows, volume, the clock and CPU and memory."
        />
        <figcaption>A real screenshot: OpenDock on a Windows desktop, with that PC's own apps and widgets.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section" id="features" aria-labelledby="features-title">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">What changes</p>
        <h2 class="title" id="features-title">Everything the taskbar did, then the things it never could.</h2>
      </header>

      <div class="feature-group">
      <div class="chapter"><span class="chapter-index">01</span><h3>Your apps</h3></div>
      <article class="feature">
        <div class="feature-copy">
          <p class="eyebrow"><Icon name="window" size={14} />Apps widget <StatusBadge status="shipped" /></p>
          <h3>Every window, one click away</h3>
          <p class="muted">
            Pinned apps and open windows share one row, grouped by app with a window count. Right-click an app for a
            live preview of each window.
          </p>
          <ul class="checks">
            <li>Click to switch, click again to minimise</li>
            <li>Shift-click or middle-click for a new window</li>
            <li>Bring your existing taskbar pins over in one step</li>
            <li>Maximised windows stop at the dock instead of sliding underneath</li>
          </ul>
        </div>
        <div class="artifact">
          <div class="wallpaper" aria-hidden="true"></div>
          <AppsPanel />
        </div>
      </article>

      <article class="feature is-flipped">
        <div class="feature-copy">
          <p class="eyebrow"><Icon name="grid" size={14} />Start widget <StatusBadge status="shipped" /></p>
          <h3>A launcher that finds things as you type</h3>
          <p class="muted">
            Start searches every installed app instantly and keeps your favourites pinned. Power options are there too,
            and the ones that end your session ask twice.
          </p>
          <ul class="checks">
            <li>Arrow keys and Enter, no mouse needed</li>
            <li>Pin or unpin straight from the results</li>
            <li>Prefer Windows Start? One setting switches it back</li>
          </ul>
        </div>
        <div class="artifact">
          <div class="wallpaper" aria-hidden="true"></div>
          <LauncherPanel />
        </div>
      </article>
      </div>

      <div class="feature-group">
      <div class="chapter"><span class="chapter-index">02</span><h3>Make it yours</h3></div>
      <article class="feature">
        <div class="feature-copy">
          <p class="eyebrow"><Icon name="palette" size={14} />Customise <StatusBadge status="shipped" /></p>
          <h3>A dock that fits your wallpaper, and widgets that leave it</h3>
          <p class="muted">
            Skins restyle every OpenDock window and can change the dock's shape. Widgets can live on the desktop too,
            and a scene brings back a whole setup in one click.
          </p>
          <ul class="checks">
            <li>Ten built-in skins, each checked for contrast in light and dark</li>
            <li>One bar, islands or chips, with a tint for bright or busy wallpapers</li>
            <li>Desktop widgets that snap to a grid and remember each monitor</li>
            <li>Scenes never touch the taskbar setting</li>
          </ul>
        </div>
        <div class="artifact">
          <div class="wallpaper" aria-hidden="true"></div>
          <DeskPanel />
        </div>
      </article>
      </div>

      <div class="feature-group">
      <div class="chapter"><span class="chapter-index">03</span><h3>For developers</h3></div>
      <article class="feature is-flipped">
        <div class="feature-copy">
          <p class="eyebrow"><Icon name="code" size={14} />Developer widgets <StatusBadge status="shipped" /></p>
          <h3>Your repositories, builds and local models, one glance away</h3>
          <p class="muted">
            Projects finds the git repositories in the folders you choose. CI status shows the latest GitHub Actions
            runs, failures first. Local AI talks to Ollama on your own PC, and Vault capture drops a thought into
            today's Obsidian note.
          </p>
          <ul class="checks">
            <li>Branch, uncommitted changes, and ahead or behind for every repository</li>
            <li>Open a project in Cursor, VS Code, a terminal or GitHub Desktop</li>
            <li>CI status is off until you turn it on; a token stays in the system keychain</li>
          </ul>
        </div>
        <div class="artifact">
          <div class="wallpaper" aria-hidden="true"></div>
          <ProjectsPanel />
        </div>
      </article>
      </div>

      <div class="feature-group">
      <div class="chapter"><span class="chapter-index">04</span><h3>Automation and privacy</h3></div>

      <article class="feature">
        <div class="feature-copy">
          <p class="eyebrow"><Icon name="spark" size={14} />Automation Studio <StatusBadge status="shipped" /></p>
          <h3>Rules that act, with an Undo for when they shouldn't have</h3>
          <p class="muted">
            Tell the dock what to do when something happens: pause the music before a meeting, warn about a low
            battery, switch Windows to dark mode at sunset. Rules are settings you can read, not scripts.
          </p>
          <ul class="checks">
            <li>Eleven ready-made recipes to start from</li>
            <li>A dry run shows what a rule would do right now</li>
            <li>Every run is logged with the reason it fired</li>
            <li>Cooldowns and rate limits stop runaway rules</li>
          </ul>
        </div>
        <div class="artifact">
          <div class="wallpaper" aria-hidden="true"></div>
          <RuleCard />
        </div>
      </article>

      <article class="feature is-flipped">
        <div class="feature-copy">
          <p class="eyebrow"><Icon name="shield" size={14} />Privacy Ledger <StatusBadge status="shipped" /></p>
          <h3>See every request it makes</h3>
          <p class="muted">
            OpenDock has no servers and sends no telemetry. The {onlineWidgets.length} widgets that go online
            ({onlineWidgets.map((widget) => widget.name).join(", ")}) can only reach the hosts they declare. The
            daily update check is the only other request, and you can turn it off. Every one is listed in the Privacy
            Ledger.
          </p>
          <ul class="checks">
            <li>No account, ever</li>
            <li>Calendar links and tokens kept in the system keychain</li>
            <li>Everything else stays in a local database on your PC</li>
          </ul>
        </div>
        <div class="artifact">
          <div class="wallpaper" aria-hidden="true"></div>
          <LedgerPanel />
        </div>
      </article>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="widgets-title">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Widgets</p>
        <h2 class="title" id="widgets-title">{widgets.length} widgets, each answering one question.</h2>
        <p class="lead">
          Arrange them on the dock in three sizes. Each one tells you what it stores and whether it ever goes online.
        </p>
      </header>
      <div class="widget-columns">
        {
          widgetCategories.map((category) => (
            <div class="widget-group">
              <h3>{category}</h3>
              <ul class="widget-mini">
                {widgetsIn(category).map((widget) => (
                  <li>
                    <span class="glyph">
                      <Icon name={widget.icon} size={18} />
                    </span>
                    <strong>{widget.name}</strong>
                    <small>{networkNote(widget.network)}</small>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <p class="section-foot">
        <a class="link-arrow" href="/widgets/">Browse all widgets <Icon name="arrow" size={16} /></a>
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="platforms-title">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Platforms</p>
        <h2 class="title" id="platforms-title">Made for Windows, with macOS and Linux on the way.</h2>
        <p class="lead">
          The taskbar replacement is Windows-only. The macOS and Linux builds come from the same release and are there
          to try, with the caveats on the download page.
        </p>
      </header>
      <ul class="platform-grid">
        {
          platforms.map((platform) => (
            <li class="platform-card" data-for={platform.id}>
              <p class="platform-detected">Your system</p>
              <h3>{platform.name}</h3>
              <p class:list={["status-word", `is-${platform.status}`]}>{statusWord[platform.status]}</p>
              <p class="platform-req">{platform.requirement}</p>
              <p class="platform-summary">{platform.summary}</p>
              <a class="link-arrow" href={`/download/#${platform.id}`}>
                {platform.name} downloads
                <Icon name="arrow" size={16} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="restore-title">
    <div class="container guarantee">
      <header class="stack">
        <p class="eyebrow">Safe to try <StatusBadge status="shipped" /></p>
        <h2 class="title" id="restore-title">The taskbar is put back on every exit OpenDock can see.</h2>
        <p class="lead">
          Before OpenDock hides the taskbar it saves your auto-hide setting. Quit, the crash guard, launcher power
          actions, the next start, and the uninstaller all use that file. If Windows ends the session and kills
          OpenDock and the guard together, auto-hide can stay on until OpenDock starts again. You can also choose
          Restore the Windows taskbar in the dock menu or the quick-actions tray.
        </p>
        <p>
          <a class="link-arrow" href={`${repoLinks.docs("testing-matrix.md")}`}>
            What is tested, and what is not <Icon name="arrow" size={16} />
          </a>
        </p>
      </header>
      <dl class="restore-list">
        {
          restore.map((row) => (
            <div>
              <dt>{row.when}</dt>
              <dd>{row.then}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="source-title">
    <div class="container source">
      <div class="stack">
        <p class="eyebrow">Open source</p>
        <h2 class="title" id="source-title">Read it, change it, ship it.</h2>
        <p class="lead">
          OpenDock is MIT licensed and built in public with Tauri, Rust and React. Design decisions are written down,
          every change goes through review and CI, and new contributors are welcome.
        </p>
        <ul class="link-list">
          <li><a class="link-arrow" href={repoLinks.contributing}>Contributing guide <Icon name="arrow" size={16} /></a></li>
          <li>
            <a class="link-arrow" href={repoLinks.docs("architecture.md")}>How it's built <Icon name="arrow" size={16} /></a>
          </li>
          <li><a class="link-arrow" href={repoLinks.goodFirstIssues}>Good first issues <Icon name="arrow" size={16} /></a></li>
        </ul>
      </div>
      <figure class="terminal">
        <figcaption class="terminal-bar"><Icon name="terminal" size={14} />Build it yourself</figcaption>
        <pre><code><span class="comment"># Windows 10 or 11 with Node 22, pnpm 10 and Rust</span>
<span class="prompt">&gt; </span>git clone {site.repo}.git
<span class="prompt">&gt; </span>cd OpenDock
<span class="prompt">&gt; </span>pnpm install
<span class="prompt">&gt; </span>pnpm dev</code></pre>
      </figure>
    </div>
  </section>

  <section class="band" aria-labelledby="band-title">
    <div class="container band-inner">
      <div class="stack">
        <h2 class="title" id="band-title">Try OpenDock today.</h2>
        <p class="lead">
          Free, open source, and about a minute to install. If it's not for you, uninstalling puts everything back.
        </p>
      </div>
      <div class="stack">
        <div class="hero-actions">
          <PlatformDownload />
          <a class="btn btn-secondary" href={releasePageUrl(currentRelease)}>Release notes</a>
        </div>
        <p class="band-note">
          Version {currentRelease.version} for Windows 10 and 11, 64-bit, with experimental macOS and Linux builds.
          Every file has a published <a href="/download/#windows">SHA-256 checksum</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
